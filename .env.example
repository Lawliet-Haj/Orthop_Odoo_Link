# Identifiants de l'API Orthop / Mobilog (SWOM_Articles)
# Copiez ce fichier en « .env » et renseignez les vraies valeurs.
# Le fichier .env n'est PAS versionné (voir .gitignore).
ORTHOP_URL=https://hdsweb2.mustinformatique.fr:444/APIWCF/XXXX/SWOM_Articles.svc
ORTHOP_ORIGINE=3CE_TLE
ORTHOP_USERNAME=VOTRE_UTILISATEUR
ORTHOP_PASSWORD=VOTRE_MOT_DE_PASSE

# --- Synchronisation vers Odoo (utilisé par la routine /sync, à venir) ---
ODOO_SYNC_URL=https://mcm-call-support.odoo.com/api/stock/sync
ODOO_STOCK_API_KEY=VOTRE_CLE_API_STOCK
